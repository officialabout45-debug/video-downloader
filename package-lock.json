const express = require('express');
const cors = require('cors');

const app = express();

// إعدادات CORS والتعامل مع بيانات JSON
app.use(cors());
app.use(express.json());
app.use(express.urlencoded({ extended: true }));

// المسار الرئيسي لاختبار عمل السيرفر
app.get('/', (req, res) => {
  res.status(200).json({
    status: 'success',
    message: 'Social Media Video Downloader API is running smoothly on Vercel!'
  });
});

// مسار معالجة التحميل (أضف منطق التحميل الخاص بك هنا)
app.post('/api/download', async (req, res) => {
  try {
    const { url } = req.body;
    if (!url) {
      return res.status(400).json({ error: 'Please provide a valid video URL' });
    }

    // هنا تضع الكود الخاص باستخراج الفيديو
    return res.status(200).json({
      message: 'Download request received',
      url: url
    });
  } catch (error) {
    return res.status(500).json({ error: 'An error occurred during processing' });
  }
});

// التعامل مع المسارات غير الموجودة (404)
app.use((req, res) => {
  res.status(404).json({ error: 'Route not found' });
});

// التشغيل المحلي فقط (عند التطوير على حاسوبك)
const PORT = process.env.PORT || 3000;
if (process.env.NODE_ENV !== 'production') {
  app.listen(PORT, () => {
    console.log(`Server is running on port ${PORT}`);
  });
}

// تصدير تطبيق Express لتتمكن Vercel من تشغيله كـ Serverless Function
module.exports = app;
